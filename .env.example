# Copy this file to .env (in the main project folder) for the frontend.
# Never commit the actual .env file.

# OAuth client ID for Google sign-in, from Google Cloud Console
# (APIs & Services > Credentials). Use the same value as
# GOOGLE_CLIENT_ID in backend/.env. Leave empty to hide the
# "Sign in with Google" button.
VITE_GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
