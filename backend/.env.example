# Copy this file to .env and fill in the real shared database credentials.
# Never commit the actual .env file.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require

# Signs login tokens. Use a long random value, at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<random-secret>

# OAuth client ID for Google sign-in, from Google Cloud Console
# (APIs & Services > Credentials). Use the same value as
# VITE_GOOGLE_CLIENT_ID in the frontend .env.
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
